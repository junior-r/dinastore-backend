DATABASE_URL="postgresql://dinastore:dinastore@localhost:5432/dinastore?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN_SECONDS=86400

FRONTEND_URL="http://localhost:4321"

# Public base URL this API is reachable at -- used to build absolute URLs for
# uploaded files (e.g. product images) served from /uploads.
APP_URL="http://localhost:3000"

# How many reverse proxies sit in front of this API (load balancer, CDN).
# Leave unset when the API is reached directly, as in local development.
# In production behind a proxy this MUST be set (usually "1"), or the
# product-view history records the proxy's address for every visitor instead
# of their own. Do not set it higher than the real number of proxies: that
# would let a caller choose their own address via X-Forwarded-For.
# TRUST_PROXY="1"

# Where uploaded files (comment images) are stored. "local" writes to this
# machine's disk and serves them from /uploads -- fine for development or a
# single server. To use anything else, add an adapter + a case in
# src/shared/infrastructure/storage/storage.module.ts and name it here.
STORAGE_DRIVER="local"
# local driver only: directory to write to (relative to the project root, or
# absolute).
STORAGE_LOCAL_DIR="uploads"
# Optional. Public base URL the stored files are reachable at, if something
# other than this API serves them (a CDN or reverse proxy). Defaults to
# {APP_URL}/uploads.
STORAGE_PUBLIC_URL=""

# The store logo stamped on every customer design (design studio). A PNG with
# transparency works best. Relative to the project root, or absolute. The
# file shipped at this path is a temporary wordmark: replace the file, or
# point this at the real one, and restart.
STORE_LOGO_PATH="assets/store-logo.png"

# Google OAuth ("Continue with Google"). Create credentials at
# https://console.cloud.google.com/apis/credentials — OAuth client ID, type
# "Web application", with this exact authorized redirect URI:
#   http://localhost:3000/auth/google/callback
# Leave unset to develop without Google login (the rest of the app is unaffected).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# Comment moderation via the standalone feelings-analysis service (sibling
# project, ../feelings-analysis). Leave unset to use only the local
# keyword-based fallback (KeywordCommentModerationAdapter) — the app still
# works either way. FEELINGS_ANALYSIS_API_KEY must exactly match that
# service's own SERVICE_API_KEY (see feelings-analysis/.env.example).
FEELINGS_ANALYSIS_URL="http://localhost:8000"
FEELINGS_ANALYSIS_API_KEY=""
FEELINGS_ANALYSIS_TIMEOUT_MS=5000

# docker-compose.yml (local infra) reads these
POSTGRES_USER=dinastore
POSTGRES_PASSWORD=dinastore
POSTGRES_DB=dinastore
POSTGRES_PORT=5432
REDIS_PORT=6379
